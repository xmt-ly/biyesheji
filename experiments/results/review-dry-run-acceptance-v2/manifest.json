      "openai": "2.54.0",
      "httpx": "0.28.1",
      "pydantic": "2.12.5",
      "SQLAlchemy": "2.0.45",
      "fastapi": "0.135.3"
    }
  },
  "information_scope": {
    "chat_only": "聊天室消息+共用名称编号目录",
    "context_only": "与agent完全相同的ProjectTools业务上下文+消息",
    "agent": "业务上下文+消息+生产工具和校验反馈"
